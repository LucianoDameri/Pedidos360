server:
  port: 8081

spring:
  datasource:
    url: jdbc:mysql://TU-HOST-CLOUD:3306/pedidos360_clientes
    username: ${DB_USERNAME}
    password: ${DB_PASSWORD}
    driver-class-name: com.mysql.cj.jdbc.Driver
  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true
    properties:
      hibernate:
        dialect: org.hibernate.dialect.MySQLDialect