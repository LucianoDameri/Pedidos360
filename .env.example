# Copia este archivo a .env (misma carpeta que docker-compose.yml) solo si necesitas cambiar algo.
# Todas las variables tienen valor por defecto: sin .env el proyecto igual levanta.

# Dominio con el que Caddy publica el frontend por HTTPS (en la EC2: <IP-con-guiones>.sslip.io).
# Tambien se agrega al CORS de los microservicios.
FRONTEND_HOST=localhost

# Direccion con la que se accede a Kafka DESDE FUERA de Docker (herramientas en tu maquina).
# Entre contenedores no se usa. En la EC2: su IP publica.
KAFKA_EXTERNAL_HOST=localhost
